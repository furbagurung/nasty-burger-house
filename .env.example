# Nasty Burger House — Square commerce backend
# Never commit a real Square access token.
# Start in sandbox; switch to production only after checkout testing is complete.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAA_xxx
SQUARE_LOCATION_ID=LOCATION_ID_HERE
SQUARE_API_VERSION=2026-08-19

# Public site origin used for Square's post-payment return URL.
# Local: http://localhost:3001
# Production: https://www.nastyburgerhouse.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional support email shown by Square hosted checkout.
SQUARE_MERCHANT_SUPPORT_EMAIL=

# Optional order alerts retained alongside Square. These do not store the order.
RESEND_API_KEY=re_xxx
ORDER_NOTIFICATION_EMAIL=admin@example.com
ORDER_NOTIFICATION_FROM=Nasty Burger House <orders@example.com>
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# LEGACY ONLY — temporary while the old custom account/admin screens are retired.
# Square now owns the commerce/order path; do not add these to a fresh Square-only setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
