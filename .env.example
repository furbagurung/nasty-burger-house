# Secure HTTPS endpoint that receives each validated pickup order.
# The payload includes customer details, line items, payment state and Drip membership.
ORDER_WEBHOOK_URL=https://example.com/nasty-burger-orders

# Optional bearer token shared with the admin/kitchen order receiver.
ORDER_WEBHOOK_SECRET=

# Inbox the receiver should notify for each new pickup order.
ORDER_NOTIFICATION_EMAIL=admin@example.com
