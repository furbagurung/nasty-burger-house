# Nasty Burger House Supabase project.
# The publishable key is safe for browser use; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://uhhurgnrydgnkzdqgiad.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_lYjQ2d1l_OFydA4aHusG1w_0aRfWWtS

# Add the project's server-only secret key locally/Vercel. Never commit the real value.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public site origin used by auth confirmation/reset links and admin email links.
# Use http://localhost:3001 locally and the production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Recommended admin email alerts (Resend). Keep the API key server-only.
RESEND_API_KEY=re_xxx
ORDER_NOTIFICATION_EMAIL=admin@example.com
# Use a sender/domain verified in Resend before production.
ORDER_NOTIFICATION_FROM=Nasty Burger House <orders@example.com>

# Optional secure HTTPS webhook for an additional kitchen/admin integration.
# Leave blank if you only use Supabase Order Control + email notifications.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
